<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>VIP 通行证</title>
    <style>
        body { background-color: #050508; color: #ffd700; font-family: -apple-system, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; overflow: hidden; }
        .auth-card { background: linear-gradient(135deg, #1a1405 0%, #050508 100%); border: 2px solid #ffd700; padding: 35px 25px; border-radius: 12px; width: 85%; max-width: 350px; text-align: center; box-shadow: 0 0 40px rgba(255,215,0,0.2); transition: all 0.3s ease; }
        .auth-card h2 { margin-top: 0; margin-bottom: 25px; letter-spacing: 2px; text-shadow: 0 0 10px #ffd700; }
        input { width: 100%; padding: 15px; margin: 10px 0; background: #000; border: 1px solid #b89742; color: #fff; border-radius: 8px; box-sizing: border-box; font-size: 16px; outline: none; transition: 0.3s;}
        input:focus { border-color: #ffd700; box-shadow: 0 0 10px rgba(255,215,0,0.3); }
        button { width: 100%; background: linear-gradient(180deg, #ffe875 0%, #ffd700 40%, #b8860b 100%); border: 2px solid #fff; padding: 15px; color: #000; font-weight: 900; font-size: 18px; border-radius: 8px; cursor: pointer; margin-top: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.5); }
        button:active { transform: translateY(2px); box-shadow: 0 2px 5px rgba(0,0,0,0.5); }
        .link-text { color: #aaa; font-size: 13px; margin-top: 20px; cursor: pointer; text-decoration: underline; }
        .back-text { color: #ffd700; font-size: 14px; margin-top: 25px; cursor: pointer; font-weight: bold; border-top: 1px dashed #555; padding-top: 15px;}
    </style>
</head>
<body>
    <div class="auth-card">
        <h2 id="formTitle">💎 贵宾登录</h2>
        <input type="text" id="username" placeholder="请输入玩家账号" autocomplete="off">
        <input type="password" id="password" placeholder="请输入密码">
        
        <button id="submitBtn" onclick="submitAuth()">进 入 大 厅</button>
        
        <div class="link-text" onclick="toggleMode()" id="switchText">首次游玩？点击这里注册账号</div>
        <div class="back-text" onclick="window.history.back()">🏠 暂不登录，先回大厅</div>
    </div>

    <script>
        let isLoginMode = true; // 默认是登录模式

        // 切换界面的文字和模式
        function toggleMode() {
            isLoginMode = !isLoginMode;
            if (isLoginMode) {
                document.getElementById('formTitle').innerText = "💎 贵宾登录";
                document.getElementById('submitBtn').innerText = "进 入 大 厅";
                document.getElementById('switchText').innerText = "首次游玩？点击这里注册账号";
            } else {
                document.getElementById('formTitle').innerText = "📝 账号注册";
                document.getElementById('submitBtn').innerText = "立 即 注 册";
                document.getElementById('switchText').innerText = "已有账号？点击这里返回登录";
            }
        }

        // 提交按钮逻辑（整合了登录和注册）
        async function submitAuth() {
            const user = document.getElementById('username').value.trim();
            const pass = document.getElementById('password').value.trim();
            
            if(!user || !pass) return alert("账号和密码不能为空！");

            if (isLoginMode) {
                // =============== 登录动作 ===============
                try {
                    let res = await fetch("https://sj1.bbhy.workers.dev/login", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ username: user, password: pass })
                    });
                    
                    let data = await res.json();
                    if (res.ok) {
                        alert("✅ 登录成功！");
                        localStorage.setItem('wd_username', user);
                        localStorage.setItem('wd_wallet', data.wallet || 0);
                        window.location.href = 'index.html'; // 成功后跳回大厅
                    } else {
                        alert("❌ 登录失败: " + data.error);
                    }
                } catch (err) {
                    alert("⚠️ 无法连接服务器，请检查网络！");
                }
            } else {
                // =============== 注册动作 ===============
                try {
                    let res = await fetch("https://sj1.bbhy.workers.dev/register", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ username: user, password: pass })
                    });
                    
                    let data = await res.json();
                    if (res.ok) {
                        alert("✅ 注册成功！请使用刚注册的账号登录。");
                        toggleMode(); // 注册成功后自动切回登录页面
                        document.getElementById('password').value = ""; // 清空密码框
                    } else {
                        alert("❌ 注册失败: " + data.error);
                    }
                } catch (err) {
                    alert("⚠️ 无法连接服务器，请检查网络！");
                }
            }
        }
    </script>
</body>
</html>