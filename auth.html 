<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>账号中心</title>
    <style>
        body { background: #050508; color: #ffd700; font-family: sans-serif; display: flex; justify-content: center; padding-top: 50px; }
        .auth-card { width: 90%; max-width: 400px; background: #111; padding: 25px; border: 1px solid #ffd700; border-radius: 12px; }
        .input-box { width: 100%; padding: 12px; margin: 10px 0; background: #000; border: 1px solid #333; color: #fff; border-radius: 6px; }
        .btn { width: 100%; padding: 12px; margin-top: 10px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }
        .btn-primary { background: #ffd700; color: #000; }
        .btn-secondary { background: transparent; border: 1px solid #ffd700; color: #ffd700; }
        .hidden { display: none; }
    </style>
</head>
<body>

<div class="auth-card" id="authBox">
    <h2 id="title" style="text-align:center; margin-bottom:20px;">用户登录</h2>
    
    <input type="text" id="user" class="input-box" placeholder="账号">
    <input type="password" id="pass" class="input-box" placeholder="密码">
    
    <button id="mainBtn" class="btn btn-primary" onclick="processAuth()">登录</button>
    <button id="toggleBtn" class="btn btn-secondary" onclick="toggleMode()">去注册</button>
    
    <div style="margin-top:15px; text-align:center; font-size:12px; color:#888;" onclick="alert('请联系 TG: @oyoyf 找回密码')">忘记密码？</div>
</div>

<script>
    let isLogin = true;

    function toggleMode() {
        isLogin = !isLogin;
        document.getElementById('title').innerText = isLogin ? '用户登录' : '新用户注册';
        document.getElementById('mainBtn').innerText = isLogin ? '登录' : '注册';
        document.getElementById('toggleBtn').innerText = isLogin ? '去注册' : '去登录';
    }

    async function processAuth() {
        const user = document.getElementById('user').value;
        const pass = document.getElementById('pass').value;
        
        if(!user || !pass) return alert("请完整填写账号密码");

        // --- 域名就是填在下面这个引号里 ---
        const response = await fetch('https://你的域名填在这里.workers.dev/api/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: isLogin ? 'login' : 'register', user, pass })
        });
        
        // 伪逻辑：注册成功后自动回到登录模式
        if(!isLogin) {
            alert("注册成功，请登录");
            toggleMode();
        }
    }
</script>
</body>
</html>